{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDCH",
  "version": "0.6.0",
  "identifier": "EDCompanionHelper",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EDCH — Elite Dangerous Companion Helper",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Elite Dangerous companion",
    "longDescription": "Reads the Elite Dangerous journal in real time: materials, engineering, wishlist and where to find each material.",
    "publisher": "BKNadir",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French",
          "German",
          "Spanish",
          "PortugueseBR",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
